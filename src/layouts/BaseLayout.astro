---
import Mark from '../components/Mark.astro';
import '../styles/global.css';
interface Props {title?:string;description?:string;active?:'books'|'posts'|'about';image?:string;}
const {title,description='收錄創用 CC 授權與公有領域的 EPUB 電子書，讓好書被更多人讀見。',active,image}=Astro.props;
const pageTitle=title?`${title}｜寶島書庫 epub.tw`:'寶島書庫 epub.tw｜閱讀是在島嶼之間航行。';
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html>
<html lang="zh-Hant-TW"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#F8F6EF"/>
<title>{pageTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<link rel="alternate" type="application/atom+xml;profile=opds-catalog;kind=navigation" title="寶島書庫 OPDS" href="/opds.xml"/>
<meta property="og:locale" content="zh_TW"/><meta property="og:site_name" content="寶島書庫 epub.tw"/><meta property="og:type" content="website"/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
{image && <meta property="og:image" content={new URL(image,Astro.site)}/>}
</head><body>
<a class="skip-link" href="#main">跳到主要內容</a>
<header class="site-header shell"><a class="brand" href="/" aria-label="寶島書庫 epub.tw 首頁"><Mark/><span class="brand-wordmark"><span>寶島書庫</span><small>epub.tw</small></span></a><nav aria-label="主要導覽"><a href="/" aria-current={active==='books'?'page':undefined}>書籍</a><a href="/posts/" aria-current={active==='posts'?'page':undefined}>最新消息</a><a href="/about.html" aria-current={active==='about'?'page':undefined}>關於</a><a href="/opds.xml">OPDS</a></nav></header>
<main id="main" class="shell" tabindex="-1"><slot/></main>
<footer class="site-footer shell"><p>我們在海洋閱讀</p><span class="footer-rule"></span><a href="/" aria-label="epub.tw 首頁">epub.tw</a></footer>
</body></html>
