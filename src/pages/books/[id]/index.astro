---
import { render } from 'astro:content';
import type { GetStaticPaths,InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BookCover from '../../../components/BookCover.astro';
import { getBooks,categories,formatDate } from '../../../lib/catalog';
export const getStaticPaths=(async()=>(await getBooks()).map((book)=>({params:{id:book.id},props:{book}}))) satisfies GetStaticPaths;
type Props=InferGetStaticPropsType<typeof getStaticPaths>;
const {book}=Astro.props;const {Content}=await render(book);const {data}=book;
---
<BaseLayout title={data.title} description={data.summary} active="books" image={data.cover}>
<nav class="breadcrumbs" aria-label="麵包屑"><a href="/">書架</a><span aria-hidden="true">/</span><span>{data.title}</span></nav>
<article class="book-detail"><div class="detail-artwork"><BookCover book={book} eager/></div><div class="detail-copy"><p class="eyebrow">{categories[data.category]} <span aria-hidden="true">／</span> EPUB</p><h1>{data.title}</h1>
<ul class="detail-contributors">{data.contributors.map((person)=><li><span>{person.name}</span><small>{person.role}</small></li>)}</ul>
<p class="book-summary">{data.summary}</p><div class="acquisition-links">{data.acquisition.map((item)=><a class="button-link" href={item.url}>{item.label}<span aria-hidden="true">↗</span></a>)}</div>
<p class="source-notice">{data.acquisition.some((item)=>item.type==='web')?'將前往外部來源頁面，依該站的流程取得 EPUB。':'EPUB 檔案由原始來源提供，本站不保存書檔。'}</p>
<div class="secondary-links"><a href={data.sourceUrl}>書籍來源 <span aria-hidden="true">↗</span></a>{data.readingUrl && <a href={data.readingUrl}>線上閱讀 <span aria-hidden="true">↗</span></a>}</div>
<dl class="book-metadata"><div><dt>{data.license.name.startsWith('CC0')?'CC0 宣告':'創用 CC 授權'}</dt><dd><a href={data.license.url} rel="license">{data.license.name}</a>{data.license.evidenceUrl && <a class="evidence-link" href={data.license.evidenceUrl}>{data.license.name.startsWith('CC0')?'來源 CC0 宣告 ↗':'來源授權聲明 ↗'}</a>}</dd></div><div><dt>語言</dt><dd>{data.language==='zh-Hant'||data.language==='zh-TW'?'繁體中文':data.language}</dd></div>
{data.publishedAt && <div><dt>出版日期</dt><dd><time datetime={data.publishedAt}>{formatDate(data.publishedAt)}</time></dd></div>}
<div><dt>加入書庫</dt><dd><time datetime={data.addedAt}>{formatDate(data.addedAt)}</time></dd></div><div><dt>書目更新</dt><dd><time datetime={data.updatedAt}>{formatDate(data.updatedAt)}</time></dd></div></dl><div class="prose book-body"><Content/></div></div></article>
<div class="page-end"><a class="text-link" href="/">← 回到書架</a><a class="text-link" href="https://github.com/taiwan/epub.tw/issues/new?template=book-report.yml">回報書目問題 ↗</a></div>
</BaseLayout>
